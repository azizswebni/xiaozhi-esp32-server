# Environment variables for Staging
# Copy this file to .env and modify with your staging credentials

# Database (CHANGE THESE!)
DB_USERNAME=root
DB_PASSWORD=CHANGE_THIS_STAGING_PASSWORD

# Redis (CHANGE THIS!)
REDIS_PASSWORD=CHANGE_THIS_STAGING_REDIS_PASSWORD

# API URL (for Vue.js build)
API_URL=https://staging-api.yourdomain.com

# Timezone
TZ=Asia/Shanghai
