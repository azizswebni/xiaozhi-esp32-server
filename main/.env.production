# Environment variables for Production
# SECURITY: Never commit this file with real credentials!
# Copy this file to .env and set secure passwords

# Database (USE STRONG PASSWORDS!)
DB_USERNAME=root
DB_PASSWORD=CHANGE_THIS_PRODUCTION_PASSWORD

# Redis (USE STRONG PASSWORDS!)
REDIS_PASSWORD=CHANGE_THIS_PRODUCTION_REDIS_PASSWORD

# API URL (for Vue.js build)
API_URL=https://api.yourdomain.com

# Timezone
TZ=Asia/Shanghai
